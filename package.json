  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "strictbuild": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "serve": "vite preview",
    "check:exports": "node scripts/check-exports.mjs",
    "check:publint": "publint",
    "check:types": "attw --pack . --profile node16",
    "check:pkg": "npm run build:lib && npm run check:exports && publint && attw --pack . --profile node16",
    "docs:typedoc": "node scripts/gen-api-stubs.mjs && typedoc --options typedoc.json --json docs/_api.json --logLevel Error",
    "docs:typedoc:en": "node scripts/gen-api-stubs.mjs --en && typedoc --options typedoc.en.json --logLevel Error",
    "docs:extras": "node scripts/gen-site-extras.mjs",
    "docs": "npm run docs:typedoc && npm run docs:extras",
    "docs:en": "npm run docs:typedoc:en",
    "docs:all": "npm run docs:typedoc && npm run docs:typedoc:en && npm run docs:extras",
    "docs:serve": "node scripts/serve-docs.mjs",
    "build:demo:pages": "vite build --outDir docs/demo --emptyOutDir",
    "prepack": "npm run build:lib",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/changelog-zh.mjs"
  },
